	<!--
		========================================================================
		CALLOUT HOTSPOTS - plugin ben thu ba cua Jerome Boccon-Gibod
		https://krpano.com/plugins/userplugins/callouthotspots/
		========================================================================

		Dung de gioi thieu dia diem: mot cham nho, keo ra mot duong dan toi
		khung chu co tieu de + noi dung. Hop de chi vao toa nha trong canh
		tren cao.

		LUU Y
		- Chua co license thi plugin dong dau mo (watermark). Ban quyen 29 EUR.
		- Plugin KHONG chay trong che do VR (tour nay da tat VR nen khong sao).
		- Yeu cau krpano toi thieu 1.19 pr4 - ban 1.20.11 dung duoc.

		CACH DUNG - dat trong <scene>:

		    <hotspot name="poi1" style="callout" ath="30" atv="-5"
		             title="Nha dieu hanh"
		             content="Phong Dao tao, phong Cong tac Sinh vien o tang 1." />

		Muon rieng cai nao khac mac dinh thi ghi de ngay tren hotspot do,
		vi du: shape="square" rotate="180" line_lenght="40"

		animation: center_screen | keep_opened | on_over | on_click
		shape    : round | square | circle
		rotate   : 0 tren-phai, 90 phai, 180 duoi, 270 trai, 360 tren-trai
	-->
	<include url="plugins/callout.xml" />

	<callout
		key=""
		size="12"
		color="0xFFFFFF"
		rotate="45"
		distancepopup="5"
		min_fov="180"
		max_fov="0"
		line_lenght="90"
		line_width="2"
		shape="circle"
		circle_active_width="46"
		animation="center_screen"
		text_width="300"
		callout_bg_border="0,0,0,2"
		text_x="10"
		css_title="color:#FFFFFF; font-family:Arial; font-size:20px; font-weight:700;"
		css_text="color:#FFFFFF; font-family:Arial; font-size:14px; line-height:1.45; text-shadow:2px 2px 6px #000000;"
		title_background="0x1E88E5"
		text_background="0x101820"
		title_padding="8 12"
		text_padding="10 10 0 0"
		/>
