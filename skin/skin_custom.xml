<krpano>

	<!--
		========================================================================
		TUỲ BIẾN THANH ĐIỀU KHIỂN
		========================================================================

		Nạp SAU vtourskin.xml và sau vtourskin_design_ultra_light.xml.

		==== BA CÁI BẪY ĐÃ DÍNH, ĐỪNG LẶP LẠI ====

		1) skin_control_bar / skin_control_bar_buttons nằm BÊN TRONG skin_layer
		   (vtourskin.xml dòng 316-353). Khai báo lại chúng ở cấp gốc theo kiểu
		   lồng thẻ sẽ gỡ chúng khỏi cây layer -> mất sạch thanh điều khiển.
		   => Thêm nút bằng cách khai báo ở cấp gốc + parent="skin_control_bar_buttons".

		2) Action skin_arrange_buttons (vtourskin.xml dòng 642) TỰ TÍNH LẠI
		   visible và x cho các nút gốc mỗi lần resize:
		     skin_btn_navi, skin_btn_prev, skin_btn_next, skin_btn_thumbs,
		     skin_btn_map, skin_btn_gyro, skin_btn_vr, skin_btn_fs
		   => Đặt x hay visible cho mấy nút đó ở đây là vô ích, bị ghi đè ngay.
		      Nút thêm mới phải ĐẶT TÊN KHÁC thì mới giữ được vị trí.

		3) Đừng gắn ?v= vào <include>. vtourskin.xml dùng <vtourskinxmlpath url="./" />
		   nên query string làm hỏng đường dẫn ảnh sprite -> mất sạch icon.
	-->

	<!--
		design_skin_images : sprite của hatinh; phần trên giữ layout chuẩn krpano,
		                     phần dưới có thêm icon home (0|760) và logo FIMO (0|1030)
		design_bgcolor/alpha : bỏ nền hẳn (alpha 0), thanh công cụ trong suốt.
		                     Muốn có nền trắng mờ trở lại thì đặt 0.18 / 0.25 / 0.3.
		thumbs             : false = bỏ dải thumbnail cuộn ngang, thay bằng
		                     bảng lưới "Tất cả các điểm" (skin/gallery.xml)
	-->
	<!--
		deeplinking : cap nhat URL theo scene va hướng nhìn đang xem
		              ?startscene=0&amp;startlookat=0,0,140,0,0;
		              index.html đã có passQueryParameters nên link mở vào đúng cảnh.
	-->
	<!--
		viewpoint_fx : hieu ung cho icon "len tren cao" / "xuong mat dat"
		  bob  = dap denh len xuong
		  halo = vong sang lan toa
		  none = tat
	-->
	<skin_settings

		title="false"

		layout_width="100%"
		layout_maxwidth="100%"

		controlbar_width="-24"
		controlbar_height="40"
		controlbar_height.mobile="48"
		controlbar_offset="20"
		controlbar_offset_closed="-40"

		design_skin_images="vtourskin-check-in.png"

		design_bgcolor="0xFFFFFF"
		design_bgalpha="0.1"
		design_bgborder="0"
		design_bgroundedge="4"
		design_bgshadow="0"

		design_text_css="color:#FFFFFF; font-family:Arial;"
		design_text_shadow="1"

		thumbs="false"

		deeplinking="true"

		viewpoint_fx="halo"

		webvr="false"
		/>


	<!--
		Các nút btn_gallery / btn_minimap / btn_home / btn_doan / btn_hoisv / btn_uet / btn_fimo giờ nằm TRỰC TIẾP
		trong skin/vtourskin.xml, ngay trong <layer name="skin_control_bar_buttons">,
		đúng cách bên hatinh làm. Khai báo từ file ngoài bằng parent="..." không lên.
	-->

	<!-- ============ CỤM LOGO: TỰ CO CHO VỪA MÀN HÌNH ============ -->

	<!--
		btn_doan / btn_hoisv / btn_uet / btn_fimo nằm trong vtourskin.xml với x cố định
		(128 / 170 / 212) tính cho màn hình rộng. Trên điện thoại 360px trở
		xuống, chỗ đó đè lên nút gyro + toàn màn hình ở mép phải.

		Action này tính lại scale và x theo bề ngang thật của thanh:
		  - còn chỗ  -> giữ nguyên cỡ desktop
		  - hơi chật -> co đều cả cụm
		  - quá chật -> ẩn logo FIMO, chia lại chỗ cho hai logo trường
		    (đổi thứ tự ưu tiên thì sửa nhánh "lg_f LT 0.62" bên dưới)
	-->
	<events name="skin_custom_events" keep="true"
		onxmlcomplete="delayedcall(0.2, skin_custom_logos(); skin_custom_rotate_check(); );"
		onresize="skin_custom_logos(); skin_custom_rotate_check();"
		/>

	<action name="skin_custom_logos">
		if(layer[btn_doan],
			<!-- controlbar_width = -24 nghĩa là rộng bằng stage trừ 24 -->
			calc(lg_barw, stagewidth - 24);

			<!--
				Mốc trái/phải khác nhau theo thiết bị vì nút to hơn trên mobile:
				  desktop: nút 32px, ba nút trái hết ở 118 -> logo từ 128
				  mobile : nút 40px, bước nhảy 44, ba nút trái hết ở 134 -> logo từ 144
				Mép phải chừa cho gyro + toàn màn hình, cộng khe hở.
			-->
			if(device.mobile,
				<!-- nut 36px, buoc 40: ba nut trai het o 122 -> logo tu 132 -->
				set(lg_left, 132);  set(lg_right, 92);  set(lg_gapbase, 6);
			  ,
				<!-- nut 32px, buoc 40: ba nut trai het o 118 -> logo tu 128 -->
				set(lg_left, 128);  set(lg_right, 100); set(lg_gapbase, 8);
			);
			calc(lg_avail, lg_barw - lg_left - lg_right);

			<!--
				Ba logo vuông (Đoàn / Hội SV / UET) cao 34px + logo FIMO rộng
				57.6px, cách nhau 8px:  34*3 + 57.6 + 8*3 = 183.6
			-->
			calc(lg_need, 102 + 57.6 + 3*lg_gapbase);
			set(lg_fimo, true);
			calc(lg_f, lg_avail / lg_need);
			if(lg_f GT 1.0, set(lg_f, 1.0); );

			<!--
				Chật quá thì bỏ FIMO trước, ba logo còn lại chia nhau chỗ:
				34*3 + 8*2 = 118. Bốn logo mà co xuống dưới 75% thì mỗi cái
				chưa tới 26px, đọc không ra.
			-->
			set(lg_show, true);
			if(lg_f LT 0.75,
				set(lg_fimo, false);
				calc(lg_need, 102 + 2*lg_gapbase);
				calc(lg_f, lg_avail / lg_need);
				if(lg_f GT 1.0, set(lg_f, 1.0); );
				<!--
					Ba logo ma con co duoi 55% (moi cai < 19px) thi khong con
					doc ra la logo gi nua - an han ca cum, tha trong con hon
					bay ba dom mau vo nghia hoac de tran ra de len nut.
				-->
				if(lg_f LT 0.55, set(lg_show, false); );
			);

			set(layer[btn_doan].visible,  get(lg_show));
			set(layer[btn_hoisv].visible, get(lg_show));
			set(layer[btn_uet].visible,   get(lg_show));
			if(!lg_show, set(lg_fimo, false); );

			calc(lg_s,   0.133 * lg_f);
			calc(lg_w,   256 * lg_s);
			calc(lg_gap, lg_gapbase * lg_f);
			calc(lg_step, lg_w + lg_gap);

			set(layer[btn_doan].scale,  get(lg_s));
			set(layer[btn_hoisv].scale, get(lg_s));
			set(layer[btn_uet].scale,   get(lg_s));

			copy(layer[btn_doan].x, lg_left);
			calc(layer[btn_hoisv].x, lg_left + lg_step);
			calc(layer[btn_uet].x,   lg_left + 2*lg_step);

			set(layer[btn_fimo].visible, get(lg_fimo));
			if(lg_fimo,
				calc(layer[btn_fimo].scale, 0.45 * lg_f);
				calc(layer[btn_fimo].x, lg_left + 3*lg_step);
			);
		);
	</action>


	<!-- ============ NHAC XOAY NGANG MAN HINH (CHI MOBILE) ============ -->

	<!--
		Tour 360 xem doc rat cuc: khung nhin hep ngang, phai quet lien tuc.
		Chi hien tren dien thoai va chi khi dang cam doc.

		Cho tat duoc: nguoi dung co the da khoa xoay man hinh trong he dieu
		hanh, luc do khong xoay ngang duoc - chan cung thi ho ket luon.
		Tat roi thi khong hien lai trong phien do nua.
	-->
	<layer name="rotate_hint" keep="true" type="container"
		align="center" width="100%" height="100%"
		bgcolor="0x101820" bgalpha="0.88"
		zorder="99999" visible="false" bgcapture="true"
		onclick="skin_custom_rotate_dismiss();"
		>

		<layer name="rotate_hint_icon" keep="true"
			url="rotate_phone.png"
			align="center" edge="center" y="-64"
			scale="0.42" enabled="false"
			/>

		<layer name="rotate_hint_text" keep="true" type="text"
			align="center" edge="center" y="46"
			bg="false" enabled="false" width="86%"
			css="color:#FFFFFF; font-family:Arial; font-size:19px; font-weight:700; text-align:center; line-height:1.45;"
			html="Xoay ngang [br]để xem rõ hơn"
			/>

		<!--
			Nut chinh: vao toan man hinh roi khoa huong ngang.
			An tren Android Chrome. iOS Safari khong co screen.orientation.lock
			nen chi vao duoc toan man hinh, nguoi dung van phai tu xoay -
			vi the van giu nguyen loi nhac va nut bo qua ben duoi.
		-->
		<layer name="rotate_hint_go" keep="true" type="text"
			visible="false"
			align="center" edge="center" y="112"
			bgcolor="0x1E88E5" bgalpha="1.0" bgroundedge="20"
			padding="10 22"
			css="color:#FFFFFF; font-family:Arial; font-size:16px; font-weight:700; text-align:center;"
			html="Xoay ngang ngay"
			onclick="js(lockLandscape());"
			/>

		<layer name="rotate_hint_skip" keep="true" type="text"
			align="center" edge="center" y="164"
			bgcolor="0xFFFFFF" bgalpha="0.14" bgroundedge="16"
			padding="7 18"
			css="color:#FFFFFF; font-family:Arial; font-size:15px; text-align:center;"
			html="Bỏ qua"
			onclick="skin_custom_rotate_dismiss();"
			/>
	</layer>

	<action name="skin_custom_rotate_check">
		<!-- tach tung dieu kien ra bien rieng cho de doc -->
		set(rt_mob, false);
		if(device.mobile, set(rt_mob, true); );

		set(rt_portrait, false);
		if(stageheight GT stagewidth, set(rt_portrait, true); );

		set(rt_off, false);
		if(rotate_hint_off == true, set(rt_off, true); );

		if(rt_mob AND rt_portrait AND !rt_off,
			set(layer[rotate_hint].visible, true);
			skin_custom_rotate_anim();
			if(can_autorotate,
				set(layer[rotate_hint_go].visible, true);
				set(layer[rotate_hint_skip].y, 164);
			  ,
				set(layer[rotate_hint_go].visible, false);
				set(layer[rotate_hint_skip].y, 112);
			);
		  ,
			set(layer[rotate_hint].visible, false);
		);
	</action>

	<!-- dien thoai nghieng dan sang ngang roi ve cho, minh hoa dong tac can lam -->
	<action name="skin_custom_rotate_anim">
		if(layer[rotate_hint].visible,
			tween(layer[rotate_hint_icon].rotate, -90, 1.1, easeinoutsine,
				delayedcall(0.6,
					tween(layer[rotate_hint_icon].rotate, 0, 0.5, easeinoutsine);
				);
			);
			delayedcall(rotate_anim, 2.6, skin_custom_rotate_anim(); );
		);
	</action>

	<action name="skin_custom_rotate_dismiss">
		set(rotate_hint_off, true);
		set(layer[rotate_hint].visible, false);
	</action>


	<!-- ============ TOOLTIP TIẾNG VIỆT ============ -->

	<action name="skin_custom_tooltips" autorun="onstart">
		delayedcall(0.5,
			skin_custom_tip(skin_btn_gyro, 'Xoay theo điện thoại');
			skin_custom_tip(skin_btn_fs,   'Toàn màn hình');
			skin_custom_tip(btn_gallery,   'Tất cả các điểm');
			skin_custom_tip(btn_minimap,   'Sơ đồ khuôn viên');
			skin_custom_tip(btn_home,      'Về điểm đầu tiên');
			skin_custom_tip(btn_doan,      'Đoàn Thanh niên Cộng sản Hồ Chí Minh');
			skin_custom_tip(btn_hoisv,     'Hội Sinh viên Việt Nam');
			skin_custom_tip(btn_uet,       'Trường Đại học Công nghệ');
			skin_custom_tip(btn_fimo,      'Powered by FIMO');
		);
	</action>

	<action name="skin_custom_tip">
		if(layer[%1],
			set(layer[%1].tooltip, %2);
			layer[%1].loadstyle(skin_tooltips);
		);
	</action>

</krpano>
