	<!--
		Pin đỏ + nón radar của điểm đang đứng.

		Chúng là con của ẢNH (không phải con của spot) và được đặt vào đúng vị trí
		bằng cách chép x/y của spot. Lý do: điểm đang đứng bị ẩn icon thường đi
		(visible=false), mà trong krpano ẩn layer cha thì con cũng biến mất theo —
		nếu gắn làm con của spot thì pin đỏ sẽ mất luôn.
	-->
	<layer name="minimap_active" keep="true" visible="false"
		parent="minimap_img"
		url="vtourskin_mapspotactive.png"
		align="center" edge="bottom"
		scale="1.67"
		zorder="4"
		enabled="false"
		/>

	<!--
		Nón hướng nhìn. Sơ đồ nền màu sáng nên nón phải TỐI mới nổi.
		  alpha     - độ mờ tổng của nón; mặc định của plugin là 0.5 nên rất nhạt,
		              đặt hẳn 1.0 rồi chỉnh độ đậm bằng fillalpha cho dễ kiểm soát
		  fillcolor - xám đậm; fillalpha càng cao càng đặc
		  linecolor - viền gần đen cho rõ mép nón
		  glow      - mặc định bật màu trắng, trên nền sáng chỉ làm mờ thêm nên tắt

		=== VÌ SAO PHẢI KHAI BÁO width/height ===
		radar.js KHÔNG tự đặt kích thước cho layer. Không có width/height thì
		edge="center" không biết lấy gì làm tâm -> nón neo sai chỗ.
		256x256 là đúng khung vẽ nội bộ của plugin; bán kính nón = 128 * scale.
		Muốn nón to/nhỏ thì chỉ đổi scale, ĐỪNG đổi width/height.
		  scale 0.55 -> bán kính ~70 px ảnh  (đang dùng, bằng cỡ trước khi sửa)
		  scale 0.70 -> ~90 px
		  scale 0.40 -> ~51 px

		=== CHỈNH ĐỈNH NÓN TRÙNG VỚI MŨI PIN ===
		Pin dùng edge="bottom" nên MŨI pin nằm đúng toạ độ x/y của spot.
		Nón dùng edge="center" nên TÂM nón nằm ở đúng toạ độ đó.

		offsetx=-3 là bù cho chính ảnh pin: mũi pin nằm ở cột 37 trên khung
		rộng 88 px, tức lệch TRÁI 6,5 px so với tâm khung. Nhân scale 0.50 của
		pin ra 3,25 -> làm tròn -3. Nếu đổi scale của style minimap_spot thì
		tính lại: offsetx = -6.5 * scale.

		Chỉnh hai số dưới đây (đơn vị: pixel trên ảnh sơ đồ gốc,
		áp dụng cho mọi điểm, không phải sửa từng spot):
		  offsety = -3  -> đẩy nón LÊN 3 px
		  offsety = +3  -> đẩy nón XUỐNG 3 px
		  offsetx       -> tương tự theo chiều ngang

		Còn muốn xoay hướng nón thì dùng headingoffset (0 = hướng 0 chỉ lên Bắc),
		hoặc chỉnh heading của từng spot bằng công cụ minimap-tool.html.
	-->
	<layer name="minimap_radar" keep="true" visible="false"
		parent="minimap_img"
		url.html5="../plugins/radar.js"
		align="center" edge="center"
		width="256" height="256"
		scale="1.68"
		zorder="2"
		enabled="false"
		heading="0.0" headingoffset="0.0"

		offsetx="-6"
		offsety="0"

		alpha="1.0"
		fillcolor="0x4A4A4A" fillalpha="0.42"
		linewidth="1.5" linecolor="0x222222" linealpha="0.85"
		glow="false"
		/>

