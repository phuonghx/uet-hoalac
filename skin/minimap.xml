	<!-- ============ ĐỒNG BỘ ============ -->

	<events name="minimap_events" keep="true"
		onnewpano="minimap_update();"
		onkeydown="minimap_keys();"
		/>

	<!-- dùng riêng cho hiệu ứng hiện lại sơ đồ sau khi đổi scene -->
	<events name="mm_sceneload" keep="true" />

	<!-- nhóm hiển thị mặc định -->
	<action name="minimap_init" autorun="onstart">
		if(!minimap_group, minimap_setgroup(matdat); );
	</action>


	<!-- ============ ACTIONS ============ -->

	<!-- trỏ pin đỏ + radar sang spot của scene hiện tại -->
	<action name="minimap_update">

		<!-- hiện lại icon thường của điểm vừa rời đi -->
		if(mm_prevspot,
			if(layer[get(mm_prevspot)], set(layer[get(mm_prevspot)].visible, true); );
		);

		txtadd(mm_spotname, 'mmspot_', get(xml.scene));

		if(layer[get(mm_spotname)],

			<!-- sơ đồ tự chuyển sang nhóm chứa scene đang xem -->
			copy(mm_g, layer[get(mm_spotname)].mmgroup);
			minimap_setgroup(get(mm_g));

			<!-- đặt pin đỏ + nón vào đúng toạ độ của spot -->
			copy(layer[minimap_active].x, layer[get(mm_spotname)].x);
			copy(layer[minimap_active].y, layer[get(mm_spotname)].y);
			calc(layer[minimap_radar].x, layer[get(mm_spotname)].x + layer[minimap_radar].offsetx);
			calc(layer[minimap_radar].y, layer[get(mm_spotname)].y + layer[minimap_radar].offsety);
			copy(layer[minimap_radar].heading, layer[get(mm_spotname)].heading);

			set(layer[minimap_active].visible, true);
			set(layer[minimap_radar].visible, true);

			<!-- ẩn icon thường tại chỗ đó, chỉ còn pin active -->
			set(layer[get(mm_spotname)].visible, false);
			copy(mm_prevspot, mm_spotname);

		,
			set(layer[minimap_active].visible, false);
			set(layer[minimap_radar].visible, false);
			set(mm_prevspot, '');
		);
	</action>


	<!--
		Click spot - xử lý như bên hatinh:
		  - sơ đồ đang phóng to  -> thu nhỏ + mờ dần, đổi scene, xong mới hiện lại
		  - sơ đồ đang ở góc     -> đổi scene luôn
		Ở chế độ cắm điểm thì click không đổi scene.
	-->
	<action name="minimap_goto">
		if(minimap_picking,
			stopdelayedcall(mm_restore);
		,
			if(layer[minimap_box].big,

				set(layer[minimap_box].enabled, false);
				minimap_toggleexpand();
				tween(layer[minimap_box].alpha, 0.0, 0.25, default,
					skin_loadscene(%1, get(skin_settings.loadscene_blend));
					set(events[mm_sceneload].onloadcomplete,
						delayedcall(mm_restore, 0.4,
							tween(layer[minimap_box].alpha, 1.0, 0.5, default,
								set(layer[minimap_box].enabled, true);
							);
							set(events[mm_sceneload].onloadcomplete, null);
						);
					);
				);

			,
				<!-- sơ đồ đang thu nhỏ: đổi scene luôn, không phải phóng to trước -->
				skin_loadscene(%1, get(skin_settings.loadscene_blend));
			);
		);
	</action>


	<!-- ============================================================
	     NHÓM ĐIỂM: mặt đất / trên cao

	     10 điểm drone chiếu xuống mặt bằng sẽ nằm chồng lên các điểm mặt đất,
	     nên mỗi lúc chỉ hiện một nhóm. Đổi scene thì sơ đồ tự nhảy sang nhóm
	     tương ứng. Ở chế độ cắm điểm thì hiện hết để còn kéo được cả 28 cái.
	     ============================================================ -->

	<action name="minimap_togglegroup">
		if(minimap_group == 'trencao',
			minimap_setgroup(matdat);
		,
			minimap_setgroup(trencao);
		);
	</action>


	<action name="minimap_setgroup">

		set(minimap_group, '%1');

		for(set(i,0), i LT scene.count, inc(i),
			txtadd(mm_n, 'mmspot_', get(scene[get(i)].name));
			if(layer[get(mm_n)],
				if(minimap_picking,
					set(layer[get(mm_n)].visible, true);
				,
					if(layer[get(mm_n)].mmgroup == minimap_group,
						set(layer[get(mm_n)].visible, true);
					,
						set(layer[get(mm_n)].visible, false);
					);
				);
			);
		);

		<!-- điểm đang đứng: chỉ hiện pin đỏ khi nó thuộc nhóm đang xem -->
		if(mm_prevspot,
			if(layer[get(mm_prevspot)],
				if(layer[get(mm_prevspot)].mmgroup == minimap_group,
					set(layer[minimap_active].visible, true);
					set(layer[minimap_radar].visible, true);
					if(!minimap_picking, set(layer[get(mm_prevspot)].visible, false); );
				,
					set(layer[minimap_active].visible, false);
					set(layer[minimap_radar].visible, false);
				);
			);
		);

		<!-- tab đang xem thì sáng, tab kia mờ -->
		if(minimap_group == 'trencao',
			set(layer[minimap_tab_air].bgcolor,    0x1E88E5);
			set(layer[minimap_tab_air].bgalpha,    0.95);
			set(layer[minimap_tab_ground].bgcolor, 0x000000);
			set(layer[minimap_tab_ground].bgalpha, 0.45);
		,
			set(layer[minimap_tab_ground].bgcolor, 0x1E88E5);
			set(layer[minimap_tab_ground].bgalpha, 0.95);
			set(layer[minimap_tab_air].bgcolor,    0x000000);
			set(layer[minimap_tab_air].bgalpha,    0.45);
		);
	</action>


	<!-- click vào ảnh sơ đồ: phóng to / thu nhỏ (như hatinh) -->
	<action name="minimap_imgclick">
		if(!minimap_picking, minimap_toggleexpand(); );
	</action>


	<!-- nút trên thanh điều khiển gọi vào đây -->
	<action name="minimap_toggle">
		minimap_show( calc(layer[minimap_box].visible ? false : true) );
	</action>


	<action name="minimap_show">
		if(%1,
			set(layer[minimap_box].visible, true);
		,
			set(layer[minimap_box].visible, false);
		);
	</action>


	<action name="minimap_toggleexpand">
		if(layer[minimap_box].big,

			set(layer[minimap_box].big, false);
			layer[minimap_box].changeorigin(righttop, righttop);
			if(device.mobile, set(mm_s, 0.1302), set(mm_s, 0.1771));
 			calc(mm_bw, 1920 * mm_s);
			calc(mm_bh, 847 * mm_s);
			tween(layer[minimap_box].x|layer[minimap_box].y, 14|14, 0.5, easeoutquad);
			tween(layer[minimap_box].width|layer[minimap_box].height, calc('' + mm_bw + '|' + mm_bh), 0.5, easeoutquad);
			tween(layer[minimap_img].scale, get(mm_s), 0.5, easeoutquad);
			set(layer[minimap_expandbtn].html, 'Phóng to');

		,

			set(layer[minimap_box].big, true);
			layer[minimap_box].changeorigin(center, center);
			<!-- kích thước lớn nhất vẫn lọt màn hình -->
			calc(mm_sw, stagewidth  * 0.92 / 1920);
			calc(mm_sh, stageheight * 0.86 / 847);
			if(mm_sw GT mm_sh, copy(mm_s, mm_sh), copy(mm_s, mm_sw));
			calc(mm_bw, 1920 * mm_s);
			calc(mm_bh, 847 * mm_s);
			tween(layer[minimap_box].x|layer[minimap_box].y, 0|0, 0.5, easeoutquad);
			tween(layer[minimap_box].width|layer[minimap_box].height, calc('' + mm_bw + '|' + mm_bh), 0.5, easeoutquad);
			tween(layer[minimap_img].scale, get(mm_s), 0.5, easeoutquad);
			set(layer[minimap_expandbtn].html, 'Thu nhỏ');

		);
	</action>


	<action name="minimap_keys">
		if(keycode == 77, minimap_show( calc(layer[minimap_box].visible ? false : true) ); );
		<!-- P = cam diem: chi dung duoc khi bat che do bien tap (?devmode=1) -->
		if(devmode == 1, if(keycode == 80, minimap_togglepick(); ); );
	</action>


	<!-- ============================================================
	     CẮM ĐIỂM

	     Bật lên rồi kéo từng pin vào đúng chỗ trên sơ đồ.
	     Nút "Hướng -5 / +5" xoay nón radar của điểm đang đứng.
	     ============================================================ -->

	<action name="minimap_togglepick">
		if(minimap_picking,
			set(minimap_picking, false);
			set(layer[minimap_pickbtn].html, 'Cắm điểm: TẮT');
			minimap_setdrag(false);
			<!-- lọc lại theo nhóm + ẩn icon thường của điểm đang đứng -->
			minimap_update();
		,
			set(minimap_picking, true);
			set(layer[minimap_pickbtn].html, 'Cắm điểm: BẬT');
			if(!layer[minimap_box].big, minimap_toggleexpand(); );
			minimap_setdrag(true);
			<!-- hiện hết 28 điểm (kể cả điểm đang đứng) để kéo được -->
			minimap_setgroup(get(minimap_group));
		);
		set(layer[minimap_pickbtn].visible, true);
		set(layer[minimap_exportbtn].visible, true);
		set(layer[minimap_headleft].visible, true);
		set(layer[minimap_headright].visible, true);
	</action>


	<action name="minimap_setdrag">
		for(set(i,0), i LT scene.count, inc(i),
			txtadd(mm_n, 'mmspot_', get(scene[get(i)].name));
			if(layer[get(mm_n)],
				if(%1,
					set(layer[get(mm_n)].ondown, 'minimap_drag();');
				,
					set(layer[get(mm_n)].ondown, '');
				);
			);
		);
	</action>


	<!-- kéo spot: chia delta cho scale của ảnh vì spot là con của ảnh đã co giãn -->
	<action name="minimap_drag">
		copy(mm_dx, x);
		copy(mm_dy, y);
		copy(mm_sx, mouse.stagex);
		copy(mm_sy, mouse.stagey);
		copy(mm_sc, layer[minimap_img].scale);
		asyncloop(pressed,
			calc(x, mm_dx + (mouse.stagex - mm_sx)/mm_sc);
			calc(y, mm_dy + (mouse.stagey - mm_sy)/mm_sc);
			<!-- kéo đúng điểm đang đứng thì pin đỏ + nón đi theo -->
			if(name == mm_prevspot,
				copy(layer[minimap_active].x, x);
				copy(layer[minimap_active].y, y);
				calc(layer[minimap_radar].x, x + layer[minimap_radar].offsetx);
				calc(layer[minimap_radar].y, y + layer[minimap_radar].offsety);
			);
		);
	</action>


	<!-- xoay nón radar của điểm đang đứng -->
	<action name="minimap_turn">
		txtadd(mm_spotname, 'mmspot_', get(xml.scene));
		if(layer[get(mm_spotname)],
			calc(layer[get(mm_spotname)].heading, layer[get(mm_spotname)].heading + %1);
			copy(layer[minimap_radar].heading, layer[get(mm_spotname)].heading);
			txtadd(mm_msg, 'heading = ', get(layer[get(mm_spotname)].heading));
			set(layer[minimap_tip].html, get(mm_msg));
			set(layer[minimap_tip].visible, true);
		);
	</action>


	<action name="minimap_export">
		set(mm_out, '');
		for(set(i,0), i LT scene.count, inc(i),
			txtadd(mm_n, 'mmspot_', get(scene[get(i)].name));
			if(layer[get(mm_n)],
				txtadd(mm_out, get(mm_out),
				       '&lt;layer name="', get(mm_n), '" style="minimap_spot"[br]',
				       '       x="', get(layer[get(mm_n)].x),
				       '" y="', get(layer[get(mm_n)].y),
				       '" heading="', get(layer[get(mm_n)].heading), '"[br]',
				       '       linkedscene="', get(scene[get(i)].name),
				       '" spottitle="', get(scene[get(i)].title), '" /&gt;[br]');
			);
		);
		set(layer[minimap_dump].html, '');
		txtadd(layer[minimap_dump].html,
		       '[b]Dán khối này đè lên phần 28 spot trong skin/minimap.xml[/b][br][br]',
		       get(mm_out));
		set(layer[minimap_dump].visible, true);
		set(layer[minimap_dumpclose].visible, true);
	</action>

</krpano>
